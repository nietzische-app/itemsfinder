# ---------------------------------------------------------------------------
# Detection engine
# ---------------------------------------------------------------------------
# Leave GOOGLE_CLOUD_VISION_API_KEY empty to run the app on the built-in mock
# engine. The UI is fully functional in that mode and labels every result with
# a "Demo engine (mock data)" badge.
#
# To use the real engine: enable the Cloud Vision API in Google Cloud, create
# an API key restricted to it, and paste it here.
GOOGLE_CLOUD_VISION_API_KEY=

# Force the mock engine even when a key is present — handy for UI work and CI.
USE_MOCK_VISION=false

# ---------------------------------------------------------------------------
# Affiliate tags
# ---------------------------------------------------------------------------
# These are read in `src/utils/affiliate.ts` and appended to outbound product
# links. NEXT_PUBLIC_ because the CTA is rendered client-side; they are public
# tracking identifiers, not secrets. Anything left blank falls back to a
# "getthelook-mvp" placeholder so links still work in development.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
NEXT_PUBLIC_TRENDYOL_AFFILIATE_ID=
NEXT_PUBLIC_ZARA_AFFILIATE_ID=
NEXT_PUBLIC_SEPHORA_AFFILIATE_ID=
NEXT_PUBLIC_MANGO_AFFILIATE_ID=
NEXT_PUBLIC_HM_AFFILIATE_ID=
NEXT_PUBLIC_ASOS_AFFILIATE_ID=
